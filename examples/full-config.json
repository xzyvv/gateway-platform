{
  "_comment": "最小但完整可运行的配置样例：Modbus TCP 单从站、两个连续寄存器点位、Web 仅监听本机。供 scripts/smoke/chain-smoke.mjs 直接消费（冒烟会 patch tcp_addr 与 web.listen_addr）。",
  "schema_version": 1,
  "buses": [
    {
      "port_name": "smoke-bus",
      "baud_rate": 9600,
      "parity": "none",
      "data_bits": 8,
      "stop_bits": 1,
      "timeout_ms": 2000,
      "protocol": "modbus",
      "retry_count": 0,
      "retry_delay_ms": 50,
      "de_pin": null,
      "modbus_mode": "rtu",
      "tcp_addr": "127.0.0.1:1502",
      "tcp_concurrent": 4,
      "channel_capacity": 128,
      "reconnect_backoff": {
        "seconds": [
          1,
          2,
          5
        ],
        "jitter_ratio": 0.0
      }
    }
  ],
  "points": [
    {
      "id": "smoke.reg0",
      "name": "冒烟-保持寄存器0",
      "device_id": null,
      "bus": "smoke-bus",
      "protocol": "modbus",
      "address": "1",
      "slave_id": 1,
      "address_num": 0,
      "data_id": null,
      "function_code": 3,
      "data_type": "u16",
      "byte_order": null,
      "register_count": 1,
      "interval": 1,
      "scale": 1.0,
      "offset": 0.0,
      "formula": null,
      "ct_ratio": null,
      "pt_ratio": null,
      "deadband": 0.0,
      "on_change": false,
      "unit": null,
      "alarm_high": null,
      "alarm_low": null,
      "aggregation": null,
      "modbus_register": null,
      "writable": false
    },
    {
      "id": "smoke.reg1",
      "name": "冒烟-保持寄存器1",
      "device_id": null,
      "bus": "smoke-bus",
      "protocol": "modbus",
      "address": "1",
      "slave_id": 1,
      "address_num": 1,
      "data_id": null,
      "function_code": 3,
      "data_type": "u16",
      "byte_order": null,
      "register_count": 1,
      "interval": 1,
      "scale": 1.0,
      "offset": 0.0,
      "formula": null,
      "ct_ratio": null,
      "pt_ratio": null,
      "deadband": 0.0,
      "on_change": false,
      "unit": null,
      "alarm_high": null,
      "alarm_low": null,
      "aggregation": null,
      "modbus_register": null,
      "writable": false
    }
  ],
  "devices": [],
  "mqtt": {
    "enabled": false,
    "broker": "mqtt://127.0.0.1:1883",
    "topic": "smoke/line1",
    "publish_interval": 5,
    "qos": 1,
    "keep_alive": 30,
    "ack_timeout_secs": null,
    "username": null,
    "password": null,
    "compression": null,
    "compression_threshold": null,
    "resume_rate_limit": null,
    "payload_template": null,
    "tls": null,
    "reconnect_backoff": {
      "seconds": [
        2,
        4,
        8,
        16,
        32,
        60
      ],
      "jitter_ratio": 0.4
    }
  },
  "sim_consumer": {
    "enabled": false,
    "batch_size": 100,
    "interval_ms": 1000,
    "log_every": 100
  },
  "ntp": {
    "server": "127.0.0.1",
    "sync_interval": 3600

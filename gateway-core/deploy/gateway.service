[Unit]
Description=Industrial Gateway Service
Documentation=https://github.com/your-org/gateway
After=network-online.target time-sync.target systemd-modules-load.service
Wants=network-online.target
# systemd-modules-load.service 是静态 unit（默认不被拉起），After= 只排序不激活。
# 必须显式 Wants=，否则 /etc/modules-load.d/ 里的串口驱动不会在开机时加载 ——
# 而设备组形式（char-ttyUSB）的 DeviceAllow 依赖驱动已加载才能解析出组名。
Wants=systemd-modules-load.service
# 等待串口设备就绪（可选：根据实际设备名调整）
# After=dev-ttyUSB0.device

[Service]
Type=simple
User=gateway
Group=gateway

# 运行目录与启动命令
WorkingDirectory=/opt/gatewayd
ExecStart=/opt/gatewayd/gatewayd

# 优雅退出：SIGTERM 触发 flush pipeline + drain 队列
KillSignal=SIGTERM
TimeoutStopSec=30

# 崩溃后自动重启
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# 环境变量
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
# 覆盖配置文件路径（变量名必须是 GATEWAY_CONFIG_PATH，代码不读 GATEWAY_CONFIG）
# Environment=GATEWAY_CONFIG_PATH=/etc/gateway/config.json

# 时区（计划任务按**墙钟**解释 cron 表达式）
# 优先级：GATEWAY_TZ（固定 UTC 偏移，不依赖 tzdata） > TZ（IANA 时区名，含夏令时）
# 两者都不设时跟随 /etc/localtime；精简镜像缺 tzdata 会静默退化成 UTC，
# 表现为「每天凌晨 2 点」整体差 8 小时。install.sh 会自动探测并写入下面一行。
# Environment=TZ=Asia/Shanghai
# Environment=GATEWAY_TZ=+08:00

# 启动前确保目录存在
ExecStartPre=/bin/mkdir -p /var/lib/gateway/certs /var/lib/gateway/ota /var/log/gateway
ExecStartPre=/bin/chown -R gateway:gateway /var/lib/gateway /var/log/gateway

# 文件描述符上限（MQTT/WebSocket/SQLite 连接池）
LimitNOFILE=65536

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true

# 可写路径
# 注意：ProtectSystem=strict 会把 /etc 整体挂成只读，ReadWritePaths= 是唯一的例外通道。
# /etc/gateway 必须在这里：Web API 改配置走 ConfigLoader::save() → atomic_write()，
# 临时文件建在**目标同目录**（/etc/gateway/）再 rename 覆盖，
# 因此需要该目录可写；缺这一条时所有在线改配置端点都会返回
# 500「runtime reloaded but disk save failed」——运行时已改、磁盘未改，重启回滚。
ReadWritePaths=/var/lib/gateway /var/log/gateway /tmp /etc/gateway

# 设备访问：硬件看门狗 + 串口
# 注意：DeviceAllow 是**白名单**语义（一旦出现任何 DeviceAllow=，未列出的设备一律拒绝）。
# 代码侧会按顺序探测 /dev/watchdog → /dev/watchdog0 → /dev/watchdog1 → /dev/softdog
# （见 gatewayd/src/bootstrap/helpers/collection.rs 的 WATCHDOG_DEVICE_CANDIDATES），
# 若这里只放行 /dev/watchdog，设备实际是 /dev/watchdog0 时，
# systemd 会在程序 open() 之前就以 EPERM 拒绝 → 看门狗静默失效，
# 表现为「设备卡死不会被硬件复位」。因此候选路径必须全部放行。
DeviceAllow=/dev/watchdog rw
DeviceAllow=/dev/watchdog0 rw
DeviceAllow=/dev/watchdog1 rw
DeviceAllow=/dev/softdog rw
# GPIO 芯片：代码硬编码打开 /dev/gpiochip0
# （见 gateway-core/src/platform/gpio.rs 的 gpiod::Chip::new("/dev/gpiochip0")），
# 且 GPIO 协议走独立采集路径、不经过 BusManager
# （见 gatewayd/src/bootstrap/helpers/collection.rs 的 init_collectors）。
# 不放行则 systemd 在 open() 之前就 EPERM 拒绝 →
# DI 采集 / DO 输出 / RS485 DE 方向控制全部静默失效。
DeviceAllow=/dev/gpiochip0 rw
# 串口：**必须用设备组形式**（char-<组名>），不能写 /dev/ttyUSB 这种「路径形式」。
# systemd v255 的实际行为（见 bpf-devices.c）：
#   - 路径形式在应用期先 stat(node)，stat 失败就**整条丢弃**
#     （"Couldn't stat device %s: %m"）——/dev/ttyUSB 不是真实节点
#     （真实节点是 /dev/ttyUSB0、/dev/ttyUSB1 …），必然被丢弃 →
#     程序 open() 之前被 EPERM 拒绝 → 全部串口协议采集不上来。
#   - 设备组形式按 /proc/devices 里的**设备组名**匹配（ttyUSB / ttyS / ttyACM
#     都是合法组名），一次放行该 major 的全部次设备：/dev/ttyUSB0..3、
#     /dev/ttyS0..3 全部覆盖，也不用维护具体端口号。
# 约束：组名必须在服务启动那一刻能在 /proc/devices 里解析（驱动模块已加载），
# 否则 systemd 解析失败 → 整条 DeviceAllow 被丢弃 → open() 之前 EPERM 拒绝。
# install.sh 会把 cp210x / ch341 / ftdi_sio / pl2303 / cdc_acm 写进
# /etc/modules-load.d/gateway-serial.conf 并立即 modprobe（见 install.sh 的 4.5 步）。
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyS rw
DeviceAllow=char-ttyACM rw
# OTA A/B 分区（默认 eMMC）。这里用**路径形式**是对的：分区节点是真实节点
# （/dev/mmcblk0p2、/dev/mmcblk0p3），不像串口那种裸设备名。
# 现场若用 SD / NVMe 做 OTA 介质，分区路径会变（/dev/sda2、/dev/nvme0n1p2 …），
# 必须同时改两处，缺一 OTA 直接失败：
#   1) 下面的 DeviceAllow（systemd 白名单，不放行则 open() 之前 EPERM）
#   2) 环境变量 GATEWAY_OTA_SLOT_A / GATEWAY_OTA_SLOT_B（决定写到哪个分区）
# install.sh 会用这两个环境变量同时改写本段与 Environment= 行
# （见 gateway-core/src/platform/ota/mod.rs 的 AbPartitionConfig::default）。
# OTA-PARTITIONS-BEGIN
DeviceAllow=/dev/mmcblk0p2 rw
DeviceAllow=/dev/mmcblk0p3 rw
# OTA-PARTITIONS-END
# Environment=GATEWAY_OTA_SLOT_A=/dev/mmcblk0p2
# Environment=GATEWAY_OTA_SLOT_B=/dev/mmcblk0p3

# 资源限制
MemoryMax=512M
CPUQuota=200%

# 禁止生成 core dump：
# 崩溃-重启循环（Restart=always）下，每次 panic 都会按 RLIMIT_CORE 落一个
# core.<pid>（几百 MB，且不在 /var/log/gateway，日志轮转管不到），
# 几次循环就能把 eMMC 剩余空间吃光，比日志增长更隐蔽。
LimitCORE=0

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gateway

# 串口权限：补充 dialout 组以访问 /dev/ttyUSB* /dev/ttyS*
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target


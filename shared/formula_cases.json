{
  "_readme": [
    "跨语言公式用例契约（O-7）。",
    "",
    "两侧测试都直接读本文件，谁也不能只改自己那一侧：",
    "  - Rust（权威实现）：gateway-core/src/pipeline/vformula/tests.rs",
    "  - 前端（浏览器端预演）：gateway-web/src/utils/formulaEngine.spec.ts",
    "",
    "字段：",
    "  name      用例名（失败时用来定位）",
    "  expr      公式表达式",
    "  args      点位取值表（可选，缺省为空表）",
    "  expected  期望求值结果（与 refs / error 三选一）",
    "  tolerance 期望值容差（可选，缺省 1e-6；两侧结果都归一到 6 位小数）",
    "  refs      期望提取到的点位引用（与 expected / error 三选一）",
    "  error     期望的错误类别（与 expected / refs 三选一）：",
    "            syntax  = 词法/语法错误（前端用 validateFormula 判定）",
    "            eval    = 求值错误（除零、非有限结果等）",
    "            missing = 引用的点位没有可用值",
    "  note      语义说明",
    "",
    "只在单侧成立的行为不要放进来（例：函数元数校验、错误文本），",
    "那些留在各自语言的测试文件里。"
  ],
  "cases": [
    {
      "name": "运算符优先级：乘除优先于加减",
      "expr": "1 + 2 * 3",
      "expected": 7
    },
    {
      "name": "括号优先",
      "expr": "(1 + 2) * 3",
      "expected": 9
    },
    {
      "name": "减法左结合",
      "expr": "10 - 4 - 3",
      "expected": 3
    },
    {
      "name": "除法保留小数",
      "expr": "10 / 4",
      "expected": 2.5
    },
    {
      "name": "取模",
      "expr": "7 % 3",
      "expected": 1
    },
    {
      "name": "负数取模朝零截断",
      "expr": "-7 % 3",
      "expected": -1,
      "note": "Rust 的 % 与 JS 的 % 同为朝零截断"
    },
    {
      "name": "幂运算右结合",
      "expr": "2^3^2",
      "expected": 512,
      "note": "2^(3^2)，不是 (2^3)^2 = 64"
    },
    {
      "name": "幂运算",
      "expr": "2^10",
      "expected": 1024
    },
    {
      "name": "一元负号作用于括号",
      "expr": "-(2+3)",
      "expected": -5
    },
    {
      "name": "一元负号与加法",
      "expr": "-3 + 5",
      "expected": 2
    },
    {
      "name": "LOG 为自然对数（非 2 为底）",
      "expr": "LOG(8)",
      "expected": 2.079442,
      "note": "ln(8)"
    },
    {
      "name": "LOG(e) = 1",
      "expr": "LOG(2.718281828459045)",
      "expected": 1
    },
    {
      "name": "ROUND 保留指定小数位",
      "expr": "ROUND(12.34567, 2)",
      "expected": 12.35
    },
    {
      "name": "ROUND 省略位数等价于 0 位",
      "expr": "ROUND(12.34567)",
      "expected": 12
    },
    {
      "name": "ROUND 半值朝 +∞ 取整",
      "expr": "ROUND(2.5)",
      "expected": 3,
      "note": "JS Math.round 语义；Rust 侧用 (x+0.5).floor() 对齐，而非 f64::round 的远离零"
    },
    {
      "name": "ROUND 负半值同样朝 +∞",
      "expr": "ROUND(-2.5)",
      "expected": -2
    },
    {
      "name": "IF 条件非零为真",
      "expr": "IF(1, 10, 20)",
      "expected": 10
    },
    {
      "name": "IF 条件为零为假",
      "expr": "IF(0, 10, 20)",
      "expected": 20
    },
    {
      "name": "AVG 为变参",
      "expr": "AVG(1, 9, 5)",
      "expected": 5
    },
    {
      "name": "MAX 为变参",
      "expr": "MAX(1, 9, 5)",
      "expected": 9
    },
    {
      "name": "MIN 为变参",
      "expr": "MIN(1, 9, 5)",
      "expected": 1
    },
    {
      "name": "ABS",
      "expr": "ABS(-3)",
      "expected": 3
    },
    {
      "name": "函数名大小写不敏感",
      "expr": "abs(-3)",
      "expected": 3
    },
    {
      "name": "SQRT",
      "expr": "SQRT(16)",
      "expected": 4
    },
    {
      "name": "POW",
      "expr": "POW(2, 8)",
      "expected": 256
    },
    {
      "name": "EXP",
      "expr": "EXP(0)",
      "expected": 1
    },
    {
      "name": "CEIL",
      "expr": "CEIL(1.2)",
      "expected": 2
    },
    {
      "name": "FLOOR",
      "expr": "FLOOR(1.8)",
      "expected": 1
    },
    {
      "name": "常量 PI",
      "expr": "PI",
      "expected": 3.141593
    },
    {
      "name": "常量 E",
      "expr": "E",
      "expected": 2.718282
    },
    {
      "name": "常量名大小写不敏感",
      "expr": "pi",
      "expected": 3.141593
    },
    {
      "name": "点位引用（花括号）",
      "expr": "{voltage} * 2",
      "args": { "voltage": 110 },
      "expected": 220
    },
    {
      "name": "点位引用 .Value 后缀剥离",
      "expr": "{p1.Value}",
      "args": { "p1": 3 },
      "expected": 3
    },
    {
      "name": "点位引用 .value 小写后缀同样剥离",
      "expr": "{p1.value}",
      "args": { "p1": 3 },
      "expected": 3
    },
    {
      "name": "裸标识符视为点位引用",
      "expr": "a * 2",
      "args": { "a": 21 },
      "expected": 42
    },
    {
      "name": "结果归一到 6 位小数",
      "expr": "1/3",
      "expected": 0.333333
    },
    {
      "name": "引用提取覆盖花括号与 .Value 后缀",
      "expr": "{a} + {b.Value} * 2",
      "refs": ["a", "b"]
    },
    {
      "name": "引用提取按首次出现顺序去重",
      "expr": "{a} + {b} + {a}",
      "refs": ["a", "b"]
    },
    {
      "name": "除零报错",
      "expr": "1/0",
      "error": "eval"
    },
    {
      "name": "取模除零报错",
      "expr": "1%0",
      "error": "eval"
    },
    {
      "name": "非法字符报语法错误",
      "expr": "2 @ + 3",
      "error": "syntax"
    },
    {
      "name": "多小数点数字报语法错误",
      "expr": "1.2.3 + 1",
      "error": "syntax",
      "note": "不能被静默解析成 1.2"
    },
    {
      "name": "花括号不配对报语法错误",
      "expr": "{p1 + 1",
      "error": "syntax"
    },
    {
      "name": "空点位引用报语法错误",
      "expr": "{} + 1",
      "error": "syntax"
    },
    {
      "name": "空公式报语法错误",
      "expr": "   ",
      "error": "syntax"
    },
    {
      "name": "括号不配对报语法错误",
      "expr": "(1 + 2",
      "error": "syntax"
    },
    {
      "name": "引用点位无可用值报缺值错误",
      "expr": "{missing} + 1",
      "args": { "other": 1 },
      "error": "missing"
    }
  ]
}

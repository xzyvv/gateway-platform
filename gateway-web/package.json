{
    "name": "gateway-web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "deploy:gateway": "npm run build && node -e \"const fs=require('node:fs');fs.rmSync('../gateway-core/ui-dist',{recursive:true,force:true});fs.cpSync('dist','../gateway-core/ui-dist',{recursive:true})\" && echo gateway ui deployed to gateway-core/ui-dist",
        "check:bundle": "node scripts/check-bundle-size.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "e2e:report": "playwright show-report",
        "e2e:install": "playwright install chromium",
        "lint": "eslint .",
        "type-check": "vue-tsc --noEmit",
        "types:export": "cargo test -p gateway-api export_ts_types && cargo test -p gateway-core export_ts_types",
        "types:check": "npm run types:export && git diff --exit-code -- src/api/generated",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,vue,css,scss}\""
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.64.0",
        "@types/node": "^26.6.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "^5.0.3",
        "@vue/test-utils": "^2.5.1",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.11.1",
        "fake-indexeddb": "^6.2.5",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.9",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.71.1",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.3",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.12"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@tauri-apps/api": "^2",
        "axios": "^1.20.0",
        "echarts": "^6.1.0",
        "element-plus": "^2.14.6",
        "pinia": "^4.0.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    }
}
